---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import RafterCalculator from '../components/RafterCalculator.astro';
import MaterialEstimator from '../components/MaterialEstimator.astro';
import EducationalGuide from '../components/EducationalGuide.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Free Rafter Calculator | Calculate Roof Rafter Length, Pitch, Rise & Birdsmouth Cuts"
  description="Free rafter calculator for roof framing. Calculate rafter length, roof pitch, total rise, birdsmouth cuts, HAP, overhang, and material takeoff with an interactive 2D roof schematic."
>
  <Header />

  <main id="main-content">
    <!-- Hero Mesh Gradient Section & Main Calculator App -->
    <div class="hero-mesh-bg">
      <div class="hero-content">
        <RafterCalculator />
      </div>
    </div>

    <!-- Material Framing Estimator -->
    <MaterialEstimator />

    <!-- Technical Educational Guide & FAQs -->
    <EducationalGuide />
  </main>

  <Footer />
</Layout>
