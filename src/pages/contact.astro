---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Us | Rafter Calculator";
const pageDescription = "Get in touch with the Rafter Calculator team. Submit feedback, report calculation bugs, request feature additions, or inquire about roof framing support.";
const canonicalUrl = "https://raftercalculator.org/contact";
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <Header />

  <main style="background-color: var(--color-canvas); min-height: 80vh; padding: 3rem 0 5rem 0;">
    <div class="container-custom" style="max-width: 900px;">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.8125rem; color: var(--color-mute);">
        <ol style="list-style: none; padding: 0; margin: 0; display: flex; align-items: center; gap: 8px;">
          <li><a href="/" style="color: var(--color-body); text-decoration: none;">Home</a></li>
          <li><span>/</span></li>
          <li style="color: var(--color-ink); font-weight: 500;">Contact Us</li>
        </ol>
      </nav>

      <!-- Hero Title Section -->
      <div style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 2rem;">
        <div class="mono-eyebrow" style="color: var(--color-mute); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          Support & Inquiries
        </div>
        <h1 style="font-size: 2.25rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.03em; margin-bottom: 1rem; line-height: 1.2;">
          Contact Our Team
        </h1>
        <p style="font-size: 1rem; color: var(--color-body); line-height: 1.6; max-width: 720px;">
          Have a question about roof pitch conversions, birdsmouth HAP calculations, material takeoff features, or technical feedback? We'd love to hear from you.
        </p>
      </div>

      <!-- Main Layout: Contact Details + Form -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
        
        <!-- Column 1: Direct Support Info -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
          
          <div class="geist-card" style="padding: 1.5rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
              <div style="width: 32px; height: 32px; background: var(--color-hairline-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--color-ink);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--color-ink); margin: 0;">Direct Support Email</h2>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin-bottom: 0.75rem;">
              Send inquiries directly to our developer & framing support desk:
            </p>
            <a href="mailto:support@raftercalculator.org" style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); font-weight: 600; text-decoration: underline;">
              support@raftercalculator.org
            </a>
          </div>

          <div class="geist-card" style="padding: 1.5rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
              <div style="width: 32px; height: 32px; background: var(--color-hairline-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--color-ink);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--color-ink); margin: 0;">Response Time</h2>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
              Our technical desk typically responds to user inquiries within <strong>24 to 48 business hours</strong>.
            </p>
          </div>

          <div class="geist-card" style="padding: 1.5rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
              <div style="width: 32px; height: 32px; background: var(--color-hairline-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--color-ink);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                </svg>
              </div>
              <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--color-ink); margin: 0;">Feature Requests</h2>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
              Are you looking for Hip & Valley rafter math, dormer calculations, or truss load tables? Let us know what framing tools you need!
            </p>
          </div>

        </div>

        <!-- Column 2: Client-Side Interactive Form -->
        <div class="geist-card" style="padding: 2rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
          <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.5rem; letter-spacing: -0.01em;">
            Send Us a Message
          </h2>
          <p style="font-size: 0.875rem; color: var(--color-mute); margin-bottom: 1.5rem;">
            Fill out the form below. All fields marked with * are required.
          </p>

          <!-- Form Container -->
          <form id="contact-form" style="display: flex; flex-direction: column; gap: 16px;" action="mailto:support@raftercalculator.org" method="post" enctype="text/plain">
            
            <!-- Name Input -->
            <div>
              <label for="contact-name" class="geist-label" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.875rem; color: var(--color-ink);">
                Full Name *
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="e.g. John Doe"
                class="geist-input" 
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-canvas);" 
              />
            </div>

            <!-- Email Input -->
            <div>
              <label for="contact-email" class="geist-label" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.875rem; color: var(--color-ink);">
                Email Address *
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="e.g. john@example.com"
                class="geist-input" 
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-canvas);" 
              />
            </div>

            <!-- Category Select -->
            <div>
              <label for="contact-category" class="geist-label" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.875rem; color: var(--color-ink);">
                Topic Category *
              </label>
              <select 
                id="contact-category" 
                name="category" 
                required 
                class="geist-select" 
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-canvas);"
              >
                <option value="General Inquiry">General Inquiry</option>
                <option value="Feature Request">Feature Request</option>
                <option value="Bug Report">Bug Report / Calculation Feedback</option>
                <option value="Framing Formula Question">Framing Formula Question</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Subject Input -->
            <div>
              <label for="contact-subject" class="geist-label" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.875rem; color: var(--color-ink);">
                Subject *
              </label>
              <input 
                type="text" 
                id="contact-subject" 
                name="subject" 
                required 
                placeholder="e.g. Question about 6/12 Pitch Seat Cut Depth"
                class="geist-input" 
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-canvas);" 
              />
            </div>

            <!-- Message Textarea -->
            <div>
              <label for="contact-message" class="geist-label" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.875rem; color: var(--color-ink);">
                Message *
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Write your message or inquiry here..."
                class="geist-input" 
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); font-size: 0.875rem; background: var(--color-canvas); resize: vertical;"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="geist-btn-primary geist-btn-md" 
              style="width: 100%; justify-content: center; margin-top: 8px;"
            >
              <span>Submit Inquiry</span>
            </button>

          </form>

          <!-- Success State Toast (Hidden initially) -->
          <div id="contact-success" style="display: none; padding: 1.5rem; background: var(--color-hairline-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); text-align: center; margin-top: 1rem;">
            <div style="width: 40px; height: 40px; background: var(--color-ink); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">Thank You!</h3>
            <p style="font-size: 0.875rem; color: var(--color-body); margin: 0; line-height: 1.5;">
              Your message has been formatted and submitted. Our support team will review your inquiry shortly.
            </p>
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const successToast = document.getElementById('contact-success');

      if (form && successToast) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const name = form.querySelector('#contact-name')?.value?.trim() || 'Customer';
          const email = form.querySelector('#contact-email')?.value?.trim() || 'noreply@example.com';
          const category = form.querySelector('#contact-category')?.value || 'General Inquiry';
          const subject = form.querySelector('#contact-subject')?.value?.trim() || 'Website inquiry';
          const message = form.querySelector('#contact-message')?.value?.trim() || '';

          const safeSubject = encodeURIComponent(`${category}: ${subject}`);
          const safeBody = encodeURIComponent(
            `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`
          );

          window.location.href = `mailto:support@raftercalculator.org?subject=${safeSubject}&body=${safeBody}`;
          form.style.display = 'none';
          successToast.style.display = 'block';
        });
      }
    });
  </script>
</Layout>
