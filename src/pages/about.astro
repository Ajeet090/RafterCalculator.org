---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About Us | Rafter Calculator";
const pageDescription = "Learn about Rafter Calculator - our mission to provide carpenters, roofers, contractors, and DIY builders with free, accurate, and visual roof framing geometry tools.";
const canonicalUrl = "https://raftercalculator.org/about";
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <Header />

  <main id="main-content" style="background-color: var(--color-canvas); min-height: 80vh; padding: 3rem 0 5rem 0;">
    <div class="container-custom" style="max-width: 900px;">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.8125rem; color: var(--color-mute);">
        <ol style="list-style: none; padding: 0; margin: 0; display: flex; align-items: center; gap: 8px;">
          <li><a href="/" style="color: var(--color-body); text-decoration: none;">Home</a></li>
          <li><span>/</span></li>
          <li style="color: var(--color-ink); font-weight: 500;">About Us</li>
        </ol>
      </nav>

      <!-- Hero Title Section -->
      <div style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--color-hairline); padding-bottom: 2rem;">
        <div class="mono-eyebrow" style="color: var(--color-mute); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          Engineering & Framing Utility
        </div>
        <h1 style="font-size: 2.25rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.03em; margin-bottom: 1rem; line-height: 1.2;">
          About Rafter Calculator
        </h1>
        <p style="font-size: 1.05rem; color: var(--color-body); line-height: 1.6; max-width: 760px;">
          Rafter Calculator (<a href="https://raftercalculator.org" style="color: var(--color-ink); font-weight: 500;">raftercalculator.org</a>) is a high-precision, free online construction tool engineered to help carpenters, roofers, general contractors, structural framers, and home builders calculate roof rafter dimensions instantly.
        </p>
      </div>

      <!-- Feature Overview Cards -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Mission Section -->
        <article class="geist-card" style="padding: 2rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
            <div style="width: 36px; height: 36px; background: var(--color-ink); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: #fff;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; font-weight: 600; color: var(--color-ink); letter-spacing: -0.01em; margin: 0;">
              Our Core Mission
            </h2>
          </div>
          <p style="color: var(--color-body); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 1rem;">
            Traditional roof framing calculations often require complex speed square conversions, cumbersome rafter tables, or clunky handheld calculators. Our mission is to streamline roof construction math into a fast, intuitive, interactive web tool that works seamlessly on computers, tablets, and smartphones right on the jobsite.
          </p>
          <p style="color: var(--color-body); font-size: 0.9375rem; line-height: 1.6;">
            We combine rigorous geometric right-triangle formulas with real-time 2D vector schematics, eliminating visual ambiguity so builders can verify plumb cuts, seat cut widths, and birdsmouth notch depths before making their first saw cut.
          </p>
        </article>

        <!-- Key Engineering Features -->
        <article class="geist-card" style="padding: 2rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
          <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--color-ink); margin-bottom: 1.25rem; letter-spacing: -0.01em;">
            What Sets Rafter Calculator Apart?
          </h2>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
            <div style="padding: 1rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas);">
              <div style="font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">📐 Dynamic 2D Visualizer</div>
              <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
                Live SVG blueprint rendering updates instantly with interactive view modes for full roof profiles, birdsmouth zoom details, and cut diagrams.
              </p>
            </div>

            <div style="padding: 1rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas);">
              <div style="font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">📏 Multi-Unit Flexibility</div>
              <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
                Seamlessly convert between Imperial Inches, Feet & Fractional 1/16th Inches, Centimeters (cm), and Meters (m) without manual conversion errors.
              </p>
            </div>

            <div style="padding: 1rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas);">
              <div style="font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">🏗️ Building Code Compliance</div>
              <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
                Integrated International Residential Code (IRC) birdsmouth notch safety warnings ensure seat cuts do not exceed 1/3 of the rafter depth.
              </p>
            </div>

            <div style="padding: 1rem; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas);">
              <div style="font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">📋 Job-site Spec Sheet Printing</div>
              <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.5; margin: 0;">
                One-click clean jobsite print template outputs organized cut lists and material takeoffs formatted specifically for paper framing plans.
              </p>
            </div>
          </div>
        </article>

        <!-- Building Standards & Disclaimers -->
        <article class="geist-card" style="padding: 2rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
          <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.75rem; letter-spacing: -0.01em;">
            Building Code & Quality Standards
          </h2>
          <p style="color: var(--color-body); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 1rem;">
            Our calculation formulas strictly follow Euclidean geometry and standard architectural conventions:
          </p>
          <div style="background: var(--color-hairline-soft); border-left: 3px solid var(--color-ink); padding: 1rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.875rem; color: var(--color-body); font-family: var(--font-mono); margin-bottom: 1rem;">
            Rafter Length = √[ (Run - ½ Ridge Thickness)² + Rise² ] + Overhang Diagonal
          </div>
          <p style="color: var(--color-body); font-size: 0.9375rem; line-height: 1.6;">
            While Rafter Calculator offers precise mathematical calculations, builders must always check local municipal building codes, snow/wind load framing charts, and architect-approved structural drawings before commencing construction.
          </p>
        </article>

        <!-- Commitment to Open & Free Access -->
        <article class="geist-card" style="padding: 2rem; background: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);">
          <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.75rem; letter-spacing: -0.01em;">
            Free & Open Access for Everyone
          </h2>
          <p style="color: var(--color-body); font-size: 0.9375rem; line-height: 1.6;">
            Rafter Calculator is 100% free to use. There are no paywalls, hidden premium tiers, or registration requirements. Whether you are framing a backyard storage shed, a custom residential home roof, or a commercial timber project, our tools are built for you.
          </p>
        </article>

      </div>

      <!-- Action Callout -->
      <div style="margin-top: 3rem; text-align: center; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a href="/" class="geist-btn-primary geist-btn-md">
          <span>Start Rafter Calculator</span>
        </a>
        <a href="/contact" class="geist-btn-secondary geist-btn-md">
          <span>Contact Support</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
